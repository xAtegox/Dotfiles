{
  "manifest_version": 3,
  "name": "λSearch",
  "version": "2.1",
  "description": "Minimal keyboard-first search page",

  "permissions": [],

  "host_permissions": [
    "https://www.google.com/*"
  ],

  "chrome_url_overrides": {
    "newtab": "index.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*"
      ],
      "css": [
        "google.css"
      ],
      "js": [
        "google.js"
      ],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["images.png", "wal-colors.css"],
      "matches": ["https://www.google.com/*"]
    }
  ]
}
