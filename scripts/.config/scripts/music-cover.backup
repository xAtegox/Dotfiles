#!/usr/bin/env python3

import os
import subprocess
import re

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")

from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, Pango


# ============================================================
# CONFIG
# ============================================================

WAL_COLORS = os.path.expanduser("~/.cache/wal/colors")
MUSIC_DIR = os.path.expanduser("~/Music")

UPDATE_INTERVAL = 500

# Maximum cover size.
# This does NOT force the window to be this large.
COVER_MAX_SIZE = 300

# Starting window size.
WINDOW_WIDTH = 450
WINDOW_HEIGHT = 520

# Actual minimum window size.
MIN_WINDOW_WIDTH = 120
MIN_WINDOW_HEIGHT = 120

AUDIO_EXTENSIONS = {
    ".mp3",
    ".flac",
    ".ogg",
    ".oga",
    ".opus",
    ".m4a",
    ".aac",
    ".wav",
    ".ape",
    ".wv",
}


# ============================================================
# COMMAND HELPERS
# ============================================================


def run(cmd):
    try:
        return subprocess.check_output(
            cmd, stderr=subprocess.DEVNULL, text=True
        ).strip()
    except Exception:
        return ""


def command_exists(cmd):
    return subprocess.call(["sh", "-c", f"command -v {cmd} >/dev/null 2>&1"]) == 0


def command(cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


# ============================================================
# PYWAL
# ============================================================


def get_wal_colors():

    try:
        with open(WAL_COLORS) as f:
            colors = [line.strip() for line in f if line.strip().startswith("#")]

        if len(colors) >= 16:
            return {
                "background": colors[0],
                "foreground": colors[7],
                **{f"color{i}": colors[i] for i in range(16)},
            }

    except Exception:
        pass

    return {
        "background": "#202020",
        "foreground": "#cccccc",
        "color2": "#889966",
        "color8": "#555555",
    }


def apply_theme():

    c = get_wal_colors()

    css = f"""
    window {{
        background-color: {c["background"]};
        color: {c["foreground"]};
    }}

    #header {{
        color: {c["foreground"]};
        font-size: 18px;
        font-weight: bold;
    }}

    #song {{
        color: {c["foreground"]};
        font-size: 15px;
    }}

    #controls {{
        color: {c["foreground"]};
        font-size: 15px;
    }}

    #normal {{
        color: {c["foreground"]};
        font-size: 14px;
    }}

    #selected {{
        color: {c["color2"]};
        font-size: 14px;
        font-weight: bold;
    }}

    progressbar trough {{
        background-color: {c["color8"]};
        min-height: 3px;
    }}

    progressbar progress {{
        background-color: {c["color2"]};
        min-height: 3px;
    }}

    treeview {{
        background-color: {c["background"]};
        color: {c["foreground"]};
    }}

    treeview.view {{
        background-color: {c["background"]};
        color: {c["foreground"]};
    }}

    treeview.view:selected {{
        background-color: {c["color8"]};
        color: {c["color2"]};
    }}

    scrollbar slider {{
        background-color: {c["color8"]};
    }}
    """

    provider = Gtk.CssProvider()
    provider.load_from_data(css.encode())

    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )


# ============================================================
# MPD
# ============================================================


def mpd_status():

    if not command_exists("mpc"):
        return None

    status = run(["mpc", "status"])

    if not status:
        return None

    lines = status.splitlines()

    if len(lines) < 2:
        return None

    line = lines[1]

    if "[playing]" in line:
        state = "playing"

    elif "[paused]" in line:
        state = "paused"

    else:
        return None

    match = re.search(r"\((\d+)%\)", line)

    progress = 0

    if match:
        progress = int(match.group(1)) / 100

    title = run(["mpc", "-f", "%title%", "current"])

    filepath = run(["mpc", "-f", "%file%", "current"])

    if filepath:
        filepath = os.path.join(MUSIC_DIR, filepath)

    return {
        "player": "mpd",
        "state": state,
        "title": title or "Unknown",
        "progress": progress,
        "file": filepath,
    }


# ============================================================
# QMMP
# ============================================================


def get_qmmp_player():

    if not command_exists("playerctl"):
        return None

    players = run(["playerctl", "-l"])

    for player in players.splitlines():
        if "qmmp" in player.lower():
            return player

    return None


def qmmp_status():

    player = get_qmmp_player()

    if not player:
        return None

    status = run(["playerctl", "-p", player, "status"])

    if status not in ("Playing", "Paused"):
        return None

    title = run(["playerctl", "-p", player, "metadata", "--format", "{{title}}"])

    position = run(["playerctl", "-p", player, "position"])

    length = run(
        ["playerctl", "-p", player, "metadata", "--format", "{{mpris:length}}"]
    )

    progress = 0

    try:
        position = float(position)
        length = float(length) / 1_000_000

        if length > 0:
            progress = position / length

    except Exception:
        pass

    art = run(["playerctl", "-p", player, "metadata", "--format", "{{mpris:artUrl}}"])

    if art.startswith("file://"):
        art = art[7:]

    return {
        "player": "qmmp",
        "state": status.lower(),
        "title": title or "Unknown",
        "progress": min(max(progress, 0), 1),
        "file": art,
    }


def get_current_player():

    info = mpd_status()

    if info:
        return info

    info = qmmp_status()

    if info:
        return info

    return {
        "player": None,
        "title": "Nothing playing",
        "progress": 0,
        "file": None,
    }


# ============================================================
# COVER
# ============================================================


def find_cover(filepath):

    if not filepath:
        return None

    directory = os.path.dirname(filepath)

    names = [
        "cover.jpg",
        "cover.jpeg",
        "cover.png",
        "Cover.jpg",
        "Cover.jpeg",
        "Cover.png",
        "folder.jpg",
        "folder.jpeg",
        "folder.png",
        "front.jpg",
        "front.jpeg",
        "front.png",
        "album.jpg",
        "album.jpeg",
        "album.png",
    ]

    for name in names:
        path = os.path.join(directory, name)

        if os.path.isfile(path):
            return path

    return None


def load_cover(filepath):

    if not filepath:
        return None

    if filepath.startswith("file://"):
        filepath = filepath[7:]

    if os.path.isfile(filepath):
        try:
            return GdkPixbuf.Pixbuf.new_from_file_at_scale(
                filepath, COVER_MAX_SIZE, COVER_MAX_SIZE, True
            )
        except Exception:
            pass

    cover = find_cover(filepath)

    if cover:
        try:
            return GdkPixbuf.Pixbuf.new_from_file_at_scale(
                cover, COVER_MAX_SIZE, COVER_MAX_SIZE, True
            )
        except Exception:
            pass

    return None


# ============================================================
# MUSIC FILES
# ============================================================


def is_audio(path):

    return (
        os.path.isfile(path) and os.path.splitext(path)[1].lower() in AUDIO_EXTENSIONS
    )


def directory_entries(path):

    try:
        entries = []

        for name in os.listdir(path):
            full = os.path.join(path, name)

            if os.path.isdir(full):
                entries.append((name, full, True))

            elif is_audio(full):
                entries.append((name, full, False))

        entries.sort(key=lambda x: (not x[2], x[0].lower()))

        return entries

    except Exception:
        return []


# ============================================================
# PLAYER CONTROLS
# ============================================================


def player_command(player, action):

    if player == "mpd":
        commands = {
            "playpause": ["mpc", "toggle"],
            "next": ["mpc", "next"],
            "previous": ["mpc", "prev"],
            "volume_up": ["mpc", "volume", "+5"],
            "volume_down": ["mpc", "volume", "-5"],
        }

        if action in commands:
            command(commands[action])

    elif player == "qmmp":
        player_name = get_qmmp_player()

        if not player_name:
            return

        commands = {
            "playpause": ["playerctl", "-p", player_name, "play-pause"],
            "next": ["playerctl", "-p", player_name, "next"],
            "previous": ["playerctl", "-p", player_name, "previous"],
            "volume_up": ["playerctl", "-p", player_name, "volume", "0.05+"],
            "volume_down": ["playerctl", "-p", player_name, "volume", "0.05-"],
        }

        if action in commands:
            command(commands[action])


# ============================================================
# GTK WINDOW
# ============================================================


class MusicWindow(Gtk.Window):
    def __init__(self):

        super().__init__(title="Cover")

        # ----------------------------------------------------
        # WINDOW
        # ----------------------------------------------------

        self.set_default_size(WINDOW_WIDTH, WINDOW_HEIGHT)

        self.set_resizable(True)

        # This is the important part:
        # GTK will no longer force the window to be as large
        # as the album artwork.
        self.set_size_request(MIN_WINDOW_WIDTH, MIN_WINDOW_HEIGHT)

        self.set_decorated(False)

        self.set_keep_above(True)

        self.set_position(Gtk.WindowPosition.CENTER)

        # Give DWM a predictable WM_CLASS.
        self.set_wmclass("music-cover", "MusicCover")

        self.connect("key-press-event", self.on_key_press)

        self.connect("destroy", Gtk.main_quit)

        # ----------------------------------------------------
        # PAGES
        # ----------------------------------------------------

        self.page = 0

        self.stack = Gtk.Stack()

        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)

        self.add(self.stack)

        self.create_cover_page()
        self.create_controls_page()
        self.create_current_playlist_page()
        self.create_browser_page()

        # ----------------------------------------------------
        # STATE
        # ----------------------------------------------------

        self.last_song = None
        self.last_wal = None

        self.playlist = []
        self.playlist_index = 0

        self.browser_path = MUSIC_DIR
        self.browser_entries = []
        self.browser_index = 0

        # ----------------------------------------------------
        # THEME
        # ----------------------------------------------------

        apply_theme()

        self.show_all()

        self.stack.set_visible_child_name("cover")

        GLib.timeout_add(UPDATE_INTERVAL, self.update)

        self.update()

    # ========================================================
    # COVER PAGE
    # ========================================================

    def create_cover_page(self):

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)

        box.set_margin_top(15)
        box.set_margin_bottom(15)
        box.set_margin_start(15)
        box.set_margin_end(15)

        header = Gtk.Label(label="Cover")

        header.set_name("header")

        box.pack_start(header, False, False, 0)

        # IMPORTANT:
        # No set_size_request(COVER_MAX_SIZE, COVER_MAX_SIZE).
        #
        # This means the image no longer dictates the minimum
        # window size.

        image_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        image_box.set_hexpand(True)
        image_box.set_vexpand(True)

        self.image = Gtk.Image()

        self.image.set_hexpand(True)
        self.image.set_vexpand(True)

        image_box.pack_start(self.image, True, True, 0)

        box.pack_start(image_box, True, True, 0)

        self.progress = Gtk.ProgressBar()

        box.pack_start(self.progress, False, False, 0)

        self.song = Gtk.Label(label="Nothing playing")

        self.song.set_name("song")

        self.song.set_ellipsize(Pango.EllipsizeMode.END)

        self.song.set_single_line_mode(True)

        self.song.set_hexpand(True)

        box.pack_start(self.song, False, False, 0)

        self.stack.add_named(box, "cover")

    # ========================================================
    # CONTROLS PAGE
    # ========================================================

    def create_controls_page(self):

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)

        box.set_margin_top(25)
        box.set_margin_bottom(25)
        box.set_margin_start(25)
        box.set_margin_end(25)

        title = Gtk.Label(label="Controls")

        title.set_name("header")

        box.pack_start(title, False, False, 10)

        controls = Gtk.Label(
            label=(
                "Space     Play / Pause\n\n"
                "←         Previous\n"
                "→         Next\n\n"
                "↑         Volume +\n"
                "↓         Volume -\n\n"
                "Tab       Next page\n"
                "q / Esc   Quit"
            )
        )

        controls.set_name("controls")
        controls.set_xalign(0)

        box.pack_start(controls, True, True, 0)

        self.stack.add_named(box, "controls")

    # ========================================================
    # CURRENT PLAYLIST PAGE
    # ========================================================

    def create_current_playlist_page(self):

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        outer.set_margin_top(15)
        outer.set_margin_bottom(15)
        outer.set_margin_start(15)
        outer.set_margin_end(15)

        title = Gtk.Label(label="Playlist")

        title.set_name("header")

        outer.pack_start(title, False, False, 0)

        self.current_playlist_store = Gtk.ListStore(str)

        self.current_playlist_view = Gtk.TreeView(model=self.current_playlist_store)

        self.current_playlist_view.set_headers_visible(False)

        self.current_playlist_view.set_hexpand(True)

        self.current_playlist_view.set_vexpand(True)

        # NO horizontal scrolling.
        # Text simply disappears outside the available width.
        self.current_playlist_view.set_enable_search(False)

        renderer = Gtk.CellRendererText()

        renderer.set_property("ellipsize", Pango.EllipsizeMode.NONE)

        column = Gtk.TreeViewColumn(None, renderer, text=0)

        column.set_expand(True)

        self.current_playlist_view.append_column(column)

        scrolled = Gtk.ScrolledWindow()

        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        scrolled.set_hexpand(True)
        scrolled.set_vexpand(True)

        scrolled.add(self.current_playlist_view)

        outer.pack_start(scrolled, True, True, 0)

        hint = Gtk.Label(
            label=("↑ / ↓ select   Enter play   d delete   c clear   r refresh")
        )

        hint.set_name("normal")

        hint.set_single_line_mode(True)

        hint.set_ellipsize(Pango.EllipsizeMode.NONE)

        outer.pack_start(hint, False, False, 0)

        self.stack.add_named(outer, "current-playlist")

    # ========================================================
    # MUSIC BROWSER PAGE
    # ========================================================

    def create_browser_page(self):

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        outer.set_margin_top(15)
        outer.set_margin_bottom(15)
        outer.set_margin_start(15)
        outer.set_margin_end(15)

        title = Gtk.Label(label="Music")

        title.set_name("header")

        outer.pack_start(title, False, False, 0)

        self.path_label = Gtk.Label(label="~/Music")

        self.path_label.set_name("normal")

        self.path_label.set_single_line_mode(True)

        self.path_label.set_ellipsize(Pango.EllipsizeMode.NONE)

        outer.pack_start(self.path_label, False, False, 0)

        # ----------------------------------------------------
        # TreeView
        # ----------------------------------------------------

        self.browser_store = Gtk.ListStore(str, bool)

        self.browser_view = Gtk.TreeView(model=self.browser_store)

        self.browser_view.set_headers_visible(False)

        self.browser_view.set_hexpand(True)

        self.browser_view.set_vexpand(True)

        self.browser_view.set_enable_search(False)

        renderer = Gtk.CellRendererText()

        # Do NOT ellipsize.
        # The rest simply gets clipped by the TreeView.
        renderer.set_property("ellipsize", Pango.EllipsizeMode.NONE)

        column = Gtk.TreeViewColumn(None, renderer, text=0)

        column.set_expand(True)

        self.browser_view.append_column(column)

        scrolled = Gtk.ScrolledWindow()

        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        scrolled.set_hexpand(True)
        scrolled.set_vexpand(True)

        scrolled.add(self.browser_view)

        outer.pack_start(scrolled, True, True, 0)

        hint = Gtk.Label(
            label=("↑ / ↓ select   Enter play/open folder   Backspace up   r refresh")
        )

        hint.set_name("normal")

        hint.set_single_line_mode(True)

        hint.set_ellipsize(Pango.EllipsizeMode.NONE)

        outer.pack_start(hint, False, False, 0)

        self.stack.add_named(outer, "browser")

    # ========================================================
    # CURRENT PLAYLIST
    # ========================================================

    def refresh_current_playlist(self):

        if not command_exists("mpc"):
            return

        output = run(["mpc", "playlist"])

        self.playlist = [line.strip() for line in output.splitlines() if line.strip()]

        self.current_playlist_store.clear()

        for song in self.playlist:
            # Filename/path only.
            # No artist metadata.
            name = os.path.basename(song)

            self.current_playlist_store.append([name])

        if self.playlist:
            if self.playlist_index >= len(self.playlist):
                self.playlist_index = len(self.playlist) - 1

            selection = self.current_playlist_view.get_selection()

            selection.select_path(self.playlist_index)

        else:
            self.playlist_index = 0

    # ========================================================
    # PLAY CURRENT PLAYLIST ITEM
    # ========================================================

    def play_current_playlist_item(self):

        if not self.playlist:
            return

        command(["mpc", "play", str(self.playlist_index + 1)])

    # ========================================================
    # DELETE CURRENT PLAYLIST ITEM
    # ========================================================

    def delete_current_playlist_item(self):

        if not self.playlist:
            return

        command(["mpc", "del", str(self.playlist_index + 1)])

        GLib.timeout_add(100, self.delayed_playlist_refresh)

    def delayed_playlist_refresh(self):

        self.refresh_current_playlist()

        return False

    # ========================================================
    # CLEAR PLAYLIST
    # ========================================================

    def clear_playlist(self):

        command(["mpc", "clear"])

        GLib.timeout_add(100, self.delayed_playlist_refresh)

    # ========================================================
    # BROWSER
    # ========================================================

    def refresh_browser(self):

        self.browser_entries = directory_entries(self.browser_path)

        self.browser_store.clear()

        for name, path, is_dir in self.browser_entries:
            if is_dir:
                display = f"[{name}]"

            else:
                # Filename only.
                display = name

            self.browser_store.append([display, is_dir])

        if self.browser_entries:
            if self.browser_index >= len(self.browser_entries):
                self.browser_index = len(self.browser_entries) - 1

            selection = self.browser_view.get_selection()

            selection.select_path(self.browser_index)

        else:
            self.browser_index = 0

        try:
            relative = os.path.relpath(self.browser_path, MUSIC_DIR)

            if relative == ".":
                relative = ""

            if relative:
                self.path_label.set_text("~/Music/" + relative)
            else:
                self.path_label.set_text("~/Music")

        except Exception:
            self.path_label.set_text(self.browser_path)

    # ========================================================
    # PLAY FOLDER
    # ========================================================

    def play_folder(self, path):

        if not command_exists("mpc"):
            return

        try:
            relative = os.path.relpath(path, MUSIC_DIR)

        except Exception:
            return

        # Replace current playlist.
        command(["mpc", "clear"])

        # Add the whole folder recursively.
        command(["mpc", "add", relative])

        # Start first song after MPD has processed it.
        GLib.timeout_add(200, self.start_playlist)

    # ========================================================
    # PLAY FILE
    # ========================================================

    def play_file(self, path):

        if not command_exists("mpc"):
            return

        try:
            relative = os.path.relpath(path, MUSIC_DIR)

        except Exception:
            return

        command(["mpc", "clear"])

        command(["mpc", "add", relative])

        GLib.timeout_add(200, self.start_playlist)

    def start_playlist(self):

        command(["mpc", "play", "1"])

        return False

    # ========================================================
    # UPDATE
    # ========================================================

    def update(self):

        info = get_current_player()

        self.song.set_text(info["title"])

        self.progress.set_fraction(min(max(info["progress"], 0), 1))

        identifier = (info["player"], info["file"], info["title"])

        if identifier != self.last_song:
            self.last_song = identifier

            self.update_cover(info["file"])

        if self.page == 2:
            self.refresh_current_playlist()

        elif self.page == 3:
            self.refresh_browser()

        # ----------------------------------------------------
        # Pywal live update
        # ----------------------------------------------------

        try:
            mtime = os.path.getmtime(WAL_COLORS)

            if mtime != self.last_wal:
                self.last_wal = mtime

                apply_theme()

        except Exception:
            pass

        return True

    # ========================================================
    # COVER UPDATE
    # ========================================================

    def update_cover(self, filepath):

        cover = load_cover(filepath)

        if cover:
            self.image.set_from_pixbuf(cover)

        else:
            self.image.clear()

    # ========================================================
    # KEYBOARD
    # ========================================================

    def on_key_press(self, widget, event):

        key = Gdk.keyval_name(event.keyval)

        # ----------------------------------------------------
        # TAB
        # ----------------------------------------------------

        if key == "Tab":
            self.page = (self.page + 1) % 4

            pages = ["cover", "controls", "current-playlist", "browser"]

            self.stack.set_visible_child_name(pages[self.page])

            if self.page == 2:
                self.refresh_current_playlist()

            elif self.page == 3:
                self.refresh_browser()

            return True

        # ----------------------------------------------------
        # QUIT
        # ----------------------------------------------------

        if key in ("q", "Escape"):
            self.destroy()

            return True

        # ----------------------------------------------------
        # CONTROLS
        # ----------------------------------------------------

        if self.page == 1:
            info = get_current_player()

            if key == "space":
                player_command(info["player"], "playpause")

                return True

            if key == "Left":
                player_command(info["player"], "previous")

                return True

            if key == "Right":
                player_command(info["player"], "next")

                return True

            if key == "Up":
                player_command(info["player"], "volume_up")

                return True

            if key == "Down":
                player_command(info["player"], "volume_down")

                return True

        # ----------------------------------------------------
        # CURRENT PLAYLIST
        # ----------------------------------------------------

        elif self.page == 2:
            if key == "Up":
                if self.playlist:
                    self.playlist_index = (self.playlist_index - 1) % len(self.playlist)

                    selection = self.current_playlist_view.get_selection()

                    selection.select_path(self.playlist_index)

                return True

            if key == "Down":
                if self.playlist:
                    self.playlist_index = (self.playlist_index + 1) % len(self.playlist)

                    selection = self.current_playlist_view.get_selection()

                    selection.select_path(self.playlist_index)

                return True

            if key == "Return":
                self.play_current_playlist_item()

                return True

            if key.lower() == "d":
                self.delete_current_playlist_item()

                return True

            if key.lower() == "c":
                self.clear_playlist()

                return True

            if key.lower() == "r":
                self.refresh_current_playlist()

                return True

        # ----------------------------------------------------
        # MUSIC BROWSER
        # ----------------------------------------------------

        elif self.page == 3:
            if key == "Up":
                if self.browser_entries:
                    self.browser_index = (self.browser_index - 1) % len(
                        self.browser_entries
                    )

                    selection = self.browser_view.get_selection()

                    selection.select_path(self.browser_index)

                return True

            if key == "Down":
                if self.browser_entries:
                    self.browser_index = (self.browser_index + 1) % len(
                        self.browser_entries
                    )

                    selection = self.browser_view.get_selection()

                    selection.select_path(self.browser_index)

                return True

            # -----------------------------------------------
            # ENTER
            # -----------------------------------------------

            if key == "Return":
                if not self.browser_entries:
                    return True

                name, path, is_dir = self.browser_entries[self.browser_index]

                if is_dir:
                    # ENTER ON FOLDER:
                    # play entire folder.
                    self.play_folder(path)

                else:
                    self.play_file(path)

                return True

            # -----------------------------------------------
            # BACKSPACE
            # -----------------------------------------------

            if key == "BackSpace":
                if self.browser_path != MUSIC_DIR:
                    parent = os.path.dirname(self.browser_path)

                    if parent.startswith(MUSIC_DIR):
                        self.browser_path = parent

                    else:
                        self.browser_path = MUSIC_DIR

                    self.browser_index = 0

                    self.refresh_browser()

                return True

            # -----------------------------------------------
            # R
            # -----------------------------------------------

            if key.lower() == "r":
                self.refresh_browser()

                return True

        return False


# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":
    window = MusicWindow()

    Gtk.main()
