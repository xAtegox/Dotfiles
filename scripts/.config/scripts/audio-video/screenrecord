#!/usr/bin/env bash

# ─────────────────────────────────────────────
# Screen recorder
# ─────────────────────────────────────────────

REC_FLAG="$HOME/.cache/recording_flag"
REC_COOLDOWN_FLAG="$HOME/.cache/recording_cooldown"

COOLDOWN_SECS=5
BASE_REC_DIR="$HOME/Videos/screenrecord"

REC_FPS=60
CPU_CRF=20
CPU_PRESET="ultrafast"

COMPRESS_CRF=26
COMPRESS_PRESET="medium"
COMPRESS_AUDIO_BITRATE="160k"
COMPRESS_SUFFIX=".compressed"

mkdir -p "$BASE_REC_DIR"
mkdir -p "$(dirname "$REC_FLAG")"

# ─────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────

is_recording() {
  [[ -f "$REC_FLAG" ]]
}

cooldown_remaining() {
  if [[ -f "$REC_COOLDOWN_FLAG" ]]; then
    local last_stop
    local now
    local elapsed

    last_stop=$(cat "$REC_COOLDOWN_FLAG" 2>/dev/null)
    now=$(date +%s)

    if [[ "$last_stop" =~ ^[0-9]+$ ]]; then
      elapsed=$((now - last_stop))

      if ((elapsed < COOLDOWN_SECS)); then
        echo $((COOLDOWN_SECS - elapsed))
        return 0
      fi
    fi
  fi

  return 1
}

# ─────────────────────────────────────────────
# Start
# ─────────────────────────────────────────────

start_recording() {

  if is_recording; then
    exit 1
  fi

  local remaining

  if remaining=$(cooldown_remaining); then
    notify-send \
      "Recording on cooldown" \
      "Wait ${remaining}s before starting again"
    exit 1
  fi

  local day_folder
  day_folder="$(date +%d-%m-%Y)"

  local session_path
  session_path="$BASE_REC_DIR/$day_folder"

  mkdir -p "$session_path"

  local timestamp
  timestamp="$(date +%H-%M-%S)"

  local output
  output="$session_path/${timestamp}.mp4"

  local geometry

  geometry="$(xrandr 2>/dev/null |
    awk '/\*/ {print $1; exit}')"

  [[ -z "$geometry" ]] && geometry="1920x1200"

  local mic_audio
  local default_sink
  local sys_audio

  mic_audio="$(pactl get-default-source 2>/dev/null)"
  default_sink="$(pactl get-default-sink 2>/dev/null)"

  if [[ -z "$mic_audio" ]]; then
    mic_audio="$(pactl info | awk -F': ' '/Default Source/ {print $2; exit}')"
  fi

  if [[ -z "$default_sink" ]]; then
    default_sink="$(pactl info | awk -F': ' '/Default Sink/ {print $2; exit}')"
  fi

  sys_audio="$(
    pactl list short sources |
      awk -v sink="${default_sink}.monitor" '$2 == sink {print $2; exit}'
  )"

  echo "$output" >"${REC_FLAG}.output"

  touch "$REC_FLAG"

  notify-send "Recording STARTED" "$timestamp — x264 CPU ${REC_FPS}fps"

  local -a ffargs=(
    -hide_banner
    -loglevel error
    -thread_queue_size 1024
    -f x11grab
    -framerate "$REC_FPS"
    -video_size "$geometry"
    -draw_mouse 1
    -i ":0.0+0,0"
  )

  local audio_map
  local -a audio_codec

  if [[ -n "$sys_audio" && -n "$mic_audio" && "$sys_audio" != "$mic_audio" ]]; then

    ffargs+=(-thread_queue_size 1024 -f pulse -i "$sys_audio")
    ffargs+=(-thread_queue_size 1024 -f pulse -i "$mic_audio")
    ffargs+=(-filter_complex "[1:a]volume=1.0[sys];[2:a]volume=1.0[mic];[sys][mic]amix=inputs=2:duration=longest:dropout_transition=0[aout]")
    audio_map="[aout]"
    audio_codec=(-c:a aac -b:a 384k)

  elif [[ -n "$sys_audio" ]]; then

    ffargs+=(-thread_queue_size 1024 -f pulse -i "$sys_audio")
    audio_map="1:a:0"
    audio_codec=(-c:a aac -b:a 384k)

  elif [[ -n "$mic_audio" ]]; then

    ffargs+=(-thread_queue_size 1024 -f pulse -i "$mic_audio")
    audio_map="1:a:0"
    audio_codec=(-c:a aac -b:a 384k)

  else

    audio_map=""
    audio_codec=(-an)

  fi

  ffargs+=(-map 0:v:0)
  [[ -n "$audio_map" ]] && ffargs+=(-map "$audio_map")
  ffargs+=("${audio_codec[@]}")

  ffargs+=(
    -c:v libx264
    -preset "$CPU_PRESET"
    -crf "$CPU_CRF"
    -pix_fmt yuv420p
    -g $((REC_FPS * 2))
    -fps_mode cfr
    -movflags +faststart
    -y "$output"
  )

  ffmpeg "${ffargs[@]}" >/dev/null 2>&1 &

  local pid=$!

  echo "$pid" >"${REC_FLAG}.pid"

  sleep 0.5

  if ! kill -0 "$pid" 2>/dev/null; then

    notify-send \
      "Recording FAILED" \
      "FFmpeg exited immediately."

    rm -f \
      "$REC_FLAG" \
      "${REC_FLAG}.pid" \
      "${REC_FLAG}.output"

    return 1
  fi

  pkill -RTMIN+12 dwmblocks 2>/dev/null
}

# ─────────────────────────────────────────────
# Post-stop compression (background)
# ─────────────────────────────────────────────

compress_background() {
  local src="$1"
  local dst="${src%.mp4}${COMPRESS_SUFFIX}.mp4"

  [[ -e "$dst" ]] && exit 0

  if nice -n 10 ffmpeg -hide_banner -loglevel error -i "$src" \
    -c:v libx264 \
    -preset "$COMPRESS_PRESET" \
    -crf "$COMPRESS_CRF" \
    -c:a aac -b:a "$COMPRESS_AUDIO_BITRATE" \
    -movflags +faststart \
    -y "$dst" >/dev/null 2>&1; then

    notify-send \
      "Recording compressed" \
      "$(basename "$dst") — $(du -h "$dst" | awk '{print $1}')"

  else

    rm -f "$dst"
    notify-send \
      "Compression FAILED" \
      "$(basename "$src")"

  fi
}

start_compression() {
  local src="$1"

  export COMPRESS_CRF COMPRESS_PRESET COMPRESS_AUDIO_BITRATE COMPRESS_SUFFIX
  export -f compress_background

  setsid bash -c 'compress_background "$1"' _ "$src" >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

# ─────────────────────────────────────────────
# Stop
# ─────────────────────────────────────────────

stop_recording() {

  if ! is_recording; then
    exit 1
  fi

  local pid
  local output

  pid="$(cat "${REC_FLAG}.pid" 2>/dev/null)"
  output="$(cat "${REC_FLAG}.output" 2>/dev/null)"

  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill -INT "$pid"

    while kill -0 "$pid" 2>/dev/null; do
      sleep 0.5
    done
  fi

  rm -f \
    "$REC_FLAG" \
    "${REC_FLAG}.pid" \
    "${REC_FLAG}.output"

  if [[ -f "$output" ]]; then

    notify-send \
      "Recording Saved" \
      "$(basename "$output") — compressing in background"

    if command -v xclip >/dev/null 2>&1; then
      printf 'file://%s' "$output" |
        xclip -selection clipboard -t text/uri-list
    fi

    start_compression "$output"

  else

    notify-send \
      "Recording Failed" \
      "No output file was created."
  fi

  date +%s >"$REC_COOLDOWN_FLAG"

  pkill -RTMIN+12 dwmblocks 2>/dev/null
}

# ─────────────────────────────────────────────
# Status
# ─────────────────────────────────────────────

status() {

  if is_recording; then
    echo "●"
  else
    return 1
  fi
}

# ─────────────────────────────────────────────
# Command
# ─────────────────────────────────────────────

case "$1" in

start)
  start_recording
  ;;

stop)
  stop_recording
  ;;

toggle)
  if is_recording; then
    stop_recording
  else
    start_recording
  fi
  ;;

status)
  status
  ;;

*)
  echo "Usage: $0 {start|stop|toggle|status}"
  exit 1
  ;;

esac
