#!/usr/bin/env bash

# ─────────────────────────────────────────────
# Screen recorder
# ─────────────────────────────────────────────

REC_FLAG="$HOME/.cache/recording_flag"
REC_COOLDOWN_FLAG="$HOME/.cache/recording_cooldown"

COOLDOWN_SECS=5
BASE_REC_DIR="$HOME/Videos/screenrecord"

# Quality/CPU tuning — quality and CPU usage are prioritized over
# file size, so both encode paths use a low QP/CRF (bigger files,
# better quality) and the hardware path is preferred whenever it
# can actually encode, since it barely touches the CPU at all.
VAAPI_QP=18       # h264_vaapi quality: lower = better quality, bigger files
CPU_CRF=20        # libx264 fallback quality: lower = better quality, bigger files
CPU_PRESET="fast" # kept fast (not "medium"/"slow") to keep the CPU-fallback path cheap

mkdir -p "$BASE_REC_DIR"
mkdir -p "$(dirname "$REC_FLAG")"

# ─────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────

is_recording() {
  [[ -f "$REC_FLAG" ]]
}

is_on_ac() {
  local supply

  for supply in /sys/class/power_supply/*; do
    [[ -f "$supply/type" ]] || continue

    if [[ "$(cat "$supply/type")" == "Mains" ]]; then
      if [[ -f "$supply/online" ]] &&
        [[ "$(cat "$supply/online")" == "1" ]]; then
        return 0
      fi
    fi
  done

  return 1
}

cooldown_remaining() {
  if [[ -f "$REC_COOLDOWN_FLAG" ]]; then
    local last_stop
    local now
    local elapsed

    last_stop=$(cat "$REC_COOLDOWN_FLAG" 2>/dev/null)
    now=$(date +%s)

    if [[ "$last_stop" =~ ^[0-9]+$ ]]; then
      elapsed=$((now - last_stop))

      if ((elapsed < COOLDOWN_SECS)); then
        echo $((COOLDOWN_SECS - elapsed))
        return 0
      fi
    fi
  fi

  return 1
}

# Probes each render node with a throwaway 1-frame encode and
# returns the first one that actually works with h264_vaapi.
# Prints nothing (and returns 1) if none do, so callers can fall
# back to the CPU path.
pick_vaapi_device() {
  local dev

  for dev in /dev/dri/renderD129 /dev/dri/renderD128; do
    [[ -e "$dev" ]] || continue

    # 128x128 is the AMD VAAPI encoder's minimum frame size — a
    # smaller test frame fails every device, hiding whether encode
    # actually works.
    if timeout 3 ffmpeg -hide_banner -loglevel error \
      -vaapi_device "$dev" \
      -f lavfi -i color=black:s=128x128:d=0.1 \
      -vf 'format=nv12,hwupload' \
      -c:v h264_vaapi -frames:v 1 -f null - \
      >/dev/null 2>&1; then
      echo "$dev"
      return 0
    fi
  done

  return 1
}

# ─────────────────────────────────────────────
# Start
# ─────────────────────────────────────────────

start_recording() {

  if is_recording; then
    exit 1
  fi

  local remaining

  if remaining=$(cooldown_remaining); then
    notify-send \
      "Recording on cooldown" \
      "Wait ${remaining}s before starting again"
    exit 1
  fi

  # Date directory
  local day_folder
  day_folder="$(date +%d-%m-%Y)"

  local session_path
  session_path="$BASE_REC_DIR/$day_folder"

  mkdir -p "$session_path"

  # Filename
  local timestamp
  timestamp="$(date +%H-%M-%S)"

  local output
  output="$session_path/${timestamp}.mp4"

  # Detect screen size
  local geometry

  geometry="$(xrandr 2>/dev/null |
    awk '/\*/ {print $1; exit}')"

  [[ -z "$geometry" ]] && geometry="1920x1200"

  # Audio devices
  local mic_audio
  local default_sink
  local sys_audio

  mic_audio="$(pactl get-default-source 2>/dev/null)"
  default_sink="$(pactl get-default-sink 2>/dev/null)"

  if [[ -z "$mic_audio" ]]; then
    mic_audio="$(pactl info | awk -F': ' '/Default Source/ {print $2; exit}')"
  fi

  if [[ -z "$default_sink" ]]; then
    default_sink="$(pactl info | awk -F': ' '/Default Sink/ {print $2; exit}')"
  fi

  sys_audio="$(
    pactl list short sources |
      awk -v sink="${default_sink}.monitor" '$2 == sink {print $2; exit}'
  )"

  # ─────────────────────────────────────────
  # Create recording state BEFORE starting
  # ─────────────────────────────────────────

  echo "$output" >"${REC_FLAG}.output"

  touch "$REC_FLAG"

  # ─────────────────────────────────────────
  # FFmpeg encode path.
  #
  # Prefers h264_vaapi (hardware encode on the iGPU's render node)
  # to keep CPU usage low; falls back to libx264 only if no VAAPI
  # device probes successfully. Either way quality is prioritized
  # over file size (low QP/CRF).
  # ─────────────────────────────────────────

  local vaapi_dev
  vaapi_dev="$(pick_vaapi_device)"

  notify-send \
    "Recording STARTED" \
    "$timestamp — $([[ -n "$vaapi_dev" ]] && echo "h264_vaapi (HW)" || echo "x264 CPU")"

  local -a ffargs=(
    -hide_banner
    -loglevel error
  )

  [[ -n "$vaapi_dev" ]] && ffargs+=(-vaapi_device "$vaapi_dev")

  ffargs+=(
    -thread_queue_size 1024
    -f x11grab
    -framerate 30
    -video_size "$geometry"
    -draw_mouse 1
    -i ":0.0+0,0"
  )

  # filter_complex parts: video only needs one when we're going
  # through VAAPI (nv12 + hwupload); audio only needs one when
  # mixing two distinct sources. Either, both, or neither may apply.
  local -a fc_parts=()
  local video_map audio_map
  local -a audio_codec

  if [[ -n "$vaapi_dev" ]]; then
    fc_parts+=("[0:v]format=nv12,hwupload[vout]")
    video_map="[vout]"
  else
    video_map="0:v:0"
  fi

  if [[ -n "$sys_audio" && -n "$mic_audio" && "$sys_audio" != "$mic_audio" ]]; then

    ffargs+=(-thread_queue_size 1024 -f pulse -i "$sys_audio")
    ffargs+=(-thread_queue_size 1024 -f pulse -i "$mic_audio")
    fc_parts+=("[1:a]volume=1.5[sys];[2:a]volume=1.2[mic];[sys][mic]amix=inputs=2:duration=longest:dropout_transition=0[aout]")
    audio_map="[aout]"
    audio_codec=(-c:a aac -b:a 192k)

  elif [[ -n "$sys_audio" ]]; then

    ffargs+=(-thread_queue_size 1024 -f pulse -i "$sys_audio")
    audio_map="1:a:0"
    audio_codec=(-c:a aac -b:a 192k)

  elif [[ -n "$mic_audio" ]]; then

    ffargs+=(-thread_queue_size 1024 -f pulse -i "$mic_audio")
    audio_map="1:a:0"
    audio_codec=(-c:a aac -b:a 192k)

  else

    audio_map=""
    audio_codec=(-an)

  fi

  if ((${#fc_parts[@]})); then
    local fc_joined="${fc_parts[0]}"
    local i
    for ((i = 1; i < ${#fc_parts[@]}; i++)); do
      fc_joined+=";${fc_parts[i]}"
    done
    ffargs+=(-filter_complex "$fc_joined")
  fi

  ffargs+=(-map "$video_map")
  [[ -n "$audio_map" ]] && ffargs+=(-map "$audio_map")
  ffargs+=("${audio_codec[@]}")

  if [[ -n "$vaapi_dev" ]]; then
    ffargs+=(
      -c:v h264_vaapi
      -qp "$VAAPI_QP"
      -g 30
    )
  else
    ffargs+=(
      -c:v libx264
      -preset "$CPU_PRESET"
      -crf "$CPU_CRF"
      -pix_fmt yuv420p
      -g 30
    )
  fi

  ffargs+=(
    -fps_mode cfr
    -movflags +faststart
    -y "$output"
  )

  ffmpeg "${ffargs[@]}" >"${REC_FLAG}.log" 2>&1 &

  local pid=$!

  echo "$pid" >"${REC_FLAG}.pid"

  # Make sure FFmpeg actually started
  sleep 0.5

  if ! kill -0 "$pid" 2>/dev/null; then

    notify-send \
      "Recording FAILED" \
      "FFmpeg exited immediately."

    rm -f \
      "$REC_FLAG" \
      "${REC_FLAG}.pid" \
      "${REC_FLAG}.output"

    if [[ -s "${REC_FLAG}.log" ]]; then
      notify-send \
        "FFmpeg error" \
        "$(tail -n 3 "${REC_FLAG}.log")"
    fi

    return 1
  fi

  pkill -RTMIN+12 dwmblocks 2>/dev/null
}

# ─────────────────────────────────────────────
# Stop
# ─────────────────────────────────────────────

stop_recording() {

  if ! is_recording; then
    exit 1
  fi

  local pid
  local output

  pid="$(cat "${REC_FLAG}.pid" 2>/dev/null)"
  output="$(cat "${REC_FLAG}.output" 2>/dev/null)"

  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then

    # Ask FFmpeg to finish the MP4 properly
    kill -INT "$pid"

    # Give FFmpeg time to finalize
    while kill -0 "$pid" 2>/dev/null; do
      sleep 0.5
    done
  fi

  rm -f \
    "$REC_FLAG" \
    "${REC_FLAG}.pid" \
    "${REC_FLAG}.output"

  if [[ -f "$output" ]]; then

    notify-send \
      "Recording Saved" \
      "$(basename "$output")"

    # Copy file URI to clipboard
    if command -v xclip >/dev/null 2>&1; then
      printf 'file://%s' "$output" |
        xclip -selection clipboard -t text/uri-list
    fi

  else

    notify-send \
      "Recording Failed" \
      "No output file was created."

    if [[ -s "${REC_FLAG}.log" ]]; then
      notify-send \
        "FFmpeg error" \
        "$(tail -n 5 "${REC_FLAG}.log")"
    fi
  fi

  date +%s >"$REC_COOLDOWN_FLAG"

  pkill -RTMIN+12 dwmblocks 2>/dev/null
}

# ─────────────────────────────────────────────
# Status
# ─────────────────────────────────────────────

status() {

  if is_recording; then
    echo "●"
  else
    return 1
  fi
}

# ─────────────────────────────────────────────
# Command
# ─────────────────────────────────────────────

case "$1" in

start)
  start_recording
  ;;

stop)
  stop_recording
  ;;

toggle)
  if is_recording; then
    stop_recording
  else
    start_recording
  fi
  ;;

status)
  status
  ;;

*)
  echo "Usage: $0 {start|stop|toggle|status}"
  exit 1
  ;;

esac
