{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "/home/atego/.config/neofetch/fox.txt",
    "padding": { "top": 0, "right": 2 },
  },
  "display": {
    "separator": ": ",
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Host" },
    { "type": "wm", "key": "WM" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    {
      "type": "disk",
      "key": "Disk",
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "block": {
        "width": 3,
        "range": [0, 15],
      },
    },
  ],
}
